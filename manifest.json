{
  "manifest_version": 3,
  "name": "DialFlow - Google Voice Power Dialer",
  "version": "2.5",
  "description": "Professional auto-dialer for Google Voice: lead queue, carrier intelligence, compliance guards, analytics and voice control.",
  "permissions": ["storage", "unlimitedStorage", "sidePanel", "alarms"],
  "host_permissions": ["https://voice.google.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open DialFlow" },
  "side_panel": { "default_path": "dashboard.html?mode=side" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    { "matches": ["https://voice.google.com/*"], "js": ["parse.js", "voiceprint.js", "content.js"], "run_at": "document_idle" }
  ]
}
